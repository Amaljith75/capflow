# ─── Web app (Next.js) ─────────────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used by webhooks, invitations email and secret storage.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts tenant integration secrets and signs unsubscribe links.
# Generate with: openssl rand -base64 32      (must be identical for web and worker)
APP_ENCRYPTION_KEY=

# ─── Email (Resend) — optional; without it email runs in sandbox mode ──────
RESEND_API_KEY=
EMAIL_FROM="Capflow <reminders@yourdomain.com>"
RESEND_WEBHOOK_SECRET=

# ─── Subscription billing — optional; without keys checkout is disabled ────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Messaging webhooks — optional ─────────────────────────────────────────
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
TWILIO_AUTH_TOKEN=
